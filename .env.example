# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
# Serves the OpenAPI UI at /api/docs and the JSON at /api/docs-json
SWAGGER_ENABLED=true

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rental_user
DB_PASSWORD=rental_pass
DB_NAME=rental_db

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Optional: `npm run seed` creates this user as platform_admin when both are set
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=change_me_admin_password
